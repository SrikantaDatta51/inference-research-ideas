\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-A}}Architecture Overview}{2}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end CPU-centric disaggregated inference flow. \textbf  {Stage\nobreakspace  {}1}: Incoming requests (chat, RAG, agentic) are classified by a workload router. \textbf  {Stage\nobreakspace  {}2}: Compute-bound prefill is routed to a multi-vendor GPU cluster (NVIDIA B200, AMD MI300X, Intel Gaudi\nobreakspace  {}3) operating at 85\%+ FLOPS utilization. \textbf  {Stage\nobreakspace  {}3}: Memory-bound decode is routed to CPU clusters (Intel Xeon AMX, AMD EPYC AVX-512, ARM Graviton4 SVE2) with EAGLE-2 speculative decoding, backed by CXL\nobreakspace  {}3.1 shared memory pool (2--16\,TB) and NVMe/object storage. \textbf  {Stage\nobreakspace  {}4}: Output tokens delivered at 3.7--47$\times $ lower cost (\$0.059/M tokens). Key insight: GPUs handle only prefill (high utilization), CPUs handle only decode (low cost).}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{3}{End-to-end CPU-centric disaggregated inference flow. \textbf {Stage~1}: Incoming requests (chat, RAG, agentic) are classified by a workload router. \textbf {Stage~2}: Compute-bound prefill is routed to a multi-vendor GPU cluster (NVIDIA B200, AMD MI300X, Intel Gaudi~3) operating at 85\%+ FLOPS utilization. \textbf {Stage~3}: Memory-bound decode is routed to CPU clusters (Intel Xeon AMX, AMD EPYC AVX-512, ARM Graviton4 SVE2) with EAGLE-2 speculative decoding, backed by CXL~3.1 shared memory pool (2--16\,TB) and NVMe/object storage. \textbf {Stage~4}: Output tokens delivered at 3.7--47$\times $ lower cost (\$0.059/M tokens). Key insight: GPUs handle only prefill (high utilization), CPUs handle only decode (low cost)}{figure.1}{}}
