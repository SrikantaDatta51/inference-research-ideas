\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cost per million output tokens: GPU-only vs. disaggregated serving. GPU-only H100 baseline (\$2.80/M, dashed line) compared to three cross-vendor disaggregated configurations. NVIDIA B200 prefill + Graviton4 decode achieves \$0.059/M (47$\times $ reduction). AMD MI300X + EPYC achieves \$0.072/M (39$\times $). Intel Gaudi\nobreakspace  {}3 + Xeon AMX achieves \$0.079/M (35$\times $). Even GPU-only MI300X (\$1.90/M) costs 32$\times $ more than the best disaggregated configuration.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:crossvendor}{{4}{9}{Cost per million output tokens: GPU-only vs. disaggregated serving. GPU-only H100 baseline (\$2.80/M, dashed line) compared to three cross-vendor disaggregated configurations. NVIDIA B200 prefill + Graviton4 decode achieves \$0.059/M (47$\times $ reduction). AMD MI300X + EPYC achieves \$0.072/M (39$\times $). Intel Gaudi~3 + Xeon AMX achieves \$0.079/M (35$\times $). Even GPU-only MI300X (\$1.90/M) costs 32$\times $ more than the best disaggregated configuration}{figure.4}{}}
